# ============================================
# SERVEUR
# ============================================
PORT=
NODE_ENV=
APP_NAME=
# Adresse publique du backend lui-même — https://api.sineshophome.com
APP_URL=
# Adresse publique du FRONTEND (site visité par les clients) —
# https://www.sineshophome.com — utilisée par CORS (voir app.js) et par
# CinetPay pour l'URL de retour après paiement.
CLIENT_URL=
# Adresse publique du backend — https://api.sineshophome.com (identique à
# APP_URL dans cette configuration)
SERVER_URL=
# Identique à CLIENT_URL (https://www.sineshophome.com) — utilisée pour
# construire TOUS les liens envoyés par email (vérification, réinitialisation,
# commande, paiement, etc.). Sans cette variable, ces liens se rabattent sur
# https://www.sineshophome.com codé en dur.
FRONTEND_URL=

# ============================================
# MONGODB
# ============================================
MONGODB_URI=
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sineshop

# ============================================
# JWT
# ============================================
# OBLIGATOIRE en production — sans cette valeur, l'application refuse de
# démarrer plutôt que d'utiliser un secret par défaut connu (visible dans
# le code source). Générez une chaîne longue et aléatoire, différente pour
# JWT_SECRET et JWT_REFRESH_SECRET (ex: openssl rand -hex 64).
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=

# ============================================
# EMAIL (Brevo) - NOTIFICATIONS PAR EMAIL
# ============================================
BREVO_API_KEY=
# ID du template unique SINE.SH♡P créé dans Brevo (Campagnes > Templates).
# Laissez vide tant que le template n'est pas importé côté Brevo : le
# système envoie alors le HTML généré en interne (comportement identique,
# aucune interruption). Une fois le template créé et son ID connu,
# renseignez-le içi pour basculer automatiquement sur l'envoi via Brevo.
BREVO_TEMPLATE_ID=
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_REPLY_TO=

# Adresses d'expédition par type de notification (voir backend/config/
# emailTemplates.js:SENDERS) — chaque champ a déjà une valeur par défaut
# raisonnable dans le code (@sineshophome.com), donc tout reste
# fonctionnel même laissé vide. À renseigner seulement si vous voulez
# personnaliser une adresse précise.
EMAIL_FROM_NOREPLY=
EMAIL_FROM_SUPPORT=
EMAIL_FROM_CONTACT=
EMAIL_FROM_ORDERS=
EMAIL_FROM_PAYMENTS=
EMAIL_FROM_DELIVERY=
EMAIL_FROM_SECURITY=
EMAIL_FROM_VERIFICATION=
EMAIL_FROM_NOTIFICATIONS=
EMAIL_FROM_RESERVATIONS=
EMAIL_FROM_SELLER=
EMAIL_FROM_PRODUCTS=
EMAIL_FROM_AFFILIATION=
EMAIL_FROM_NEWSLETTER=
EMAIL_FROM_MARKETING=
EMAIL_FROM_LEGAL=
EMAIL_FROM_PRIVACY=
# Destinataire de secours des alertes de sécurité/fraude quand aucune
# adresse spécifique n'est fournie par l'appelant.
ADMIN_ALERT_EMAIL=

# ============================================
# SMS (Infobip) - NOTIFICATIONS PAR SMS
# ============================================
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_SENDER=

# ============================================
# WHATSAPP (Infobip) — canal séparé du SMS ci-dessus, même prestataire
# (INFOBIP_API_KEY et INFOBIP_BASE_URL partagés), expéditeur différent.
# Numéro WhatsApp Infobip dédié — format MSISDN, SANS le "+".
# ============================================
INFOBIP_WHATSAPP_SENDER=2250546248319

# ============================================
# PAIEMENT (CinetPay)
# ============================================
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
# Webhook appelé par les serveurs CinetPay eux-mêmes — doit pointer vers le
# BACKEND (api.sineshophome.com), jamais vers le frontend.
CINETPAY_NOTIFY_URL=
# Page vers laquelle le CLIENT est redirigé après paiement — doit pointer
# vers le FRONTEND (www.sineshophome.com/html/confirmation.html).
CINETPAY_RETURN_URL=

# ============================================
# UPLOAD (Cloudinary) - IMAGES & VIDEOS
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# 🔥 FIREBASE PUSH NOTIFICATIONS (PRINCIPAL)
# ============================================
# Utilise le fichier JSON que tu as téléchargé depuis Firebase Console
# Place le fichier dans: backend/config/firebase/service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
"
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# ============================================
# PREFERENCES UTILISATEUR - NOTIFICATIONS
# ============================================
DEFAULT_NOTIFICATION_PREFERENCES=
ENABLE_EMAIL_NOTIFICATIONS=
ENABLE_SMS_NOTIFICATIONS=
ENABLE_PUSH_NOTIFICATIONS=
ENABLE_IN_APP_NOTIFICATIONS=

# ============================================
# TEMPS D'EXPIRATION DES NOTIFICATIONS
# ============================================
NOTIFICATION_EXPIRE_HOURS=
CART_REMINDER_HOURS=
ORDER_REMINDER_HOURS=

# ============================================
# EMAIL TEMPLATES
# ============================================
EMAIL_TEMPLATE_DIR=
EMAIL_LOGO_URL=

# ============================================
# FEATURES - ACTIVATION/DÉSACTIVATION
# ============================================
ENABLE_PAYMENT=
ENABLE_SMS=
ENABLE_EMAIL=
ENABLE_AI_ASSISTANT=
ENABLE_SOCKET=
ENABLE_NOTIFICATIONS=
ENABLE_PUSH_NOTIFICATIONS=
ENABLE_FRAUD_DETECTION=
ENABLE_PROACTIVE_AI=

# ============================================
# SÉCURITÉ
# ============================================

# ============================================
# SÉCURITÉ INSCRIPTION ADMIN
# ============================================
# Code à donner uniquement aux personnes autorisées à créer un compte
# administrateur/modérateur/support — sans ce code, l'inscription avec un de
# ces rôles est refusée (le rôle "client" reste ouvert à tous, normalement).
ADMIN_REGISTRATION_CODE=

BCRYPT_ROUNDS=
RATE_LIMIT_WINDOW=
RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=

# ============================================
# LOGS
# ============================================
LOG_LEVEL=
LOG_FILE=
LOG_MAX_SIZE=
LOG_MAX_FILES=

# ============================================
# DEVICE CONFIGURATION
# ============================================
MAX_DEVICES_PER_USER=
PUSH_TOKEN_EXPIRE_DAYS=

# ============================================
# PAIEMENT MOBILE MONEY — WAVE / ORANGE MONEY / MTN MOMO
# ============================================
# Chaque prestataire a son propre interrupteur *_ENABLED. Tant qu'il est à
# false, PaymentMethodConfig (voir models/PaymentMethodConfig.js) le garde
# désactivé côté application quelle que soit sa présence ici — aucun
# risque d'activer un prestataire par erreur avant d'avoir les vraies
# clés. Le jour où les accès sont obtenus : remplir les valeurs ci-dessous
# ET passer le bon *_ENABLED à true, rien d'autre à changer dans le code.

# --- Wave ---
# WAVE_ENABLED/WAVE_API_KEY concernent UNIQUEMENT le mode API Checkout
# complet (webhooks, confirmation automatique) — pas encore actif, à
# renseigner plus tard. Wave fonctionne DÉJÀ dès maintenant en mode "lien
# direct" (voir FinanceConfig.waveBusinessPublicLink en base, indépendant
# de ces variables) : redirection vers le lien de paiement marchand
# public, confirmation manuelle en attendant l'API complète.
WAVE_ENABLED=false
WAVE_API_KEY=
WAVE_API_BASE_URL=https://api.wave.com
WAVE_WEBHOOK_SECRET=
WAVE_REQUEST_SIGNING_SECRET=

# --- Orange Money (Orange Developer — Web Payment / M Payment) ---
ORANGE_MONEY_ENABLED=false
ORANGE_APP_ID=
ORANGE_APP_NAME=SINE.SHOP
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_AUTHORIZATION_HEADER=
ORANGE_REDIRECT_URI=https://api.sineshophome.com/api/orange/callback
ORANGE_API_BASE_URL=https://api.orange.com
ORANGE_TOKEN_URL=https://api.orange.com/oauth/v3/token

# --- MTN MoMo ---
MTN_ENABLED=false
MTN_API_BASE_URL=
MTN_API_KEY=
MTN_API_SECRET=
MTN_SUBSCRIPTION_KEY=

# --- Activation globale des paiements (toutes méthodes confondues) ---
ENABLE_PAYMENT=false

# --- Carte bancaire (Visa/Mastercard) — structure préparée, AUCUN
# prestataire choisi pour l'instant. Ne jamais inventer un prestataire ou
# une URL ici : à remplir seulement une fois le vrai prestataire adapté à
# la Côte d'Ivoire sélectionné. Les informations de carte ne doivent
# JAMAIS être saisies directement dans un formulaire SINE.SHOP — toujours
# via le formulaire hébergé et sécurisé du prestataire choisi. ---
CARD_PAYMENT_ENABLED=false
CARD_PAYMENT_PROVIDER=
CARD_PAYMENT_PUBLIC_KEY=
CARD_PAYMENT_SECRET_KEY=
CARD_PAYMENT_WEBHOOK_SECRET=
